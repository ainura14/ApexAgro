# Скопировать в .env на сервере и заполнить. .env в git не коммитить.
STAGE_DOMAIN=stage.example.kg
APP_IMAGE=ghcr.io/su3r3n/apexbackend:stage

# Пароли: длинные случайные (openssl rand -base64 24)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_PASSWORD=

# Тестовые номера для фиксированного OTP-кода (через запятую)
SMS_TEST_NUMBERS=+996700000001,+996700000002
