# Nginx перед приложением. ${STAGE_DOMAIN} подставляется из окружения при старте контейнера.

server {
    listen 80;
    server_name ${STAGE_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }   # продление сертификата
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${STAGE_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${STAGE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STAGE_DOMAIN}/privkey.pem;

    client_max_body_size 20m;                         # загрузка фото (уточнить с BE2)
    add_header Strict-Transport-Security "max-age=31536000" always;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Метрики — не наружу (Prometheus ходит внутри сети или через туннель)
    location /actuator/prometheus { deny all; }

    # SSE (ИИ-чат, BE3-50) и WebSocket (чат) — без буферизации
    location /api/v1/ai/ {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
    location /ws {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}
